# ─── SAS Retrieval Agent Manager connection ──────────────────────────
# Base URL of the RAM API
RAM_API_URL=https://your-ram-host/SASRetrievalAgentManager/api/v1

# Set to false if your environment uses self-signed certificates
#RAM_VERIFY_SSL=true

# ─── Authentication ──────────────────────────────────────────────────
# Standalone RAM deployments (Keycloak): NOTHING ELSE IS NEEDED.
# With only RAM_API_URL set, the UI shows a "Sign in" button that runs the
# device code flow (with PKCE) against RAM's pre-configured public client.
# Sign in once with your RAM user (e.g. AppAdmin); the backend then keeps the
# session alive with the refresh token.
#
# Defaults you can override if your deployment differs:
#RAM_CLIENT_ID=sas-ram-api
#RAM_REALM=sas-iot

# Option A: paste a static bearer token (expires per your policy — demos only)
#RAM_TOKEN=eyJhbGciOi...

# Option B: a registered OAuth client — the backend fetches + refreshes tokens
# itself, no interactive sign-in. On standalone RAM, create a Keycloak client
# with "Direct access grants" enabled and point SAS_LOGON_URL at the realm's
# token endpoint.
#SAS_CLIENT_ID=ram-chat-ui
#SAS_CLIENT_SECRET=secret          # omit for a public (secret-less) client
#SAS_USERNAME=AppAdmin             # password grant; omit for client_credentials
#SAS_PASSWORD=your-password
#SAS_LOGON_URL=https://your-ram-host/SASRetrievalAgentManager/auth/realms/sas-iot/protocol/openid-connect/token
# (On full SAS Viya, SAS_LOGON_URL defaults to https://host/SASLogon/oauth/token)

# ─── Demo mode ───────────────────────────────────────────────────────
# Run the whole UI against an in-memory mock, no RAM needed
#RAM_MOCK=true
