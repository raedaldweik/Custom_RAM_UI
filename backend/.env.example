# ─── SAS Retrieval Agent Manager connection ──────────────────────────
# Base URL of the RAM API on your Viya deployment
RAM_API_URL=https://your-viya-host/SASRetrievalAgentManager/api/v1

# Option A (simplest): paste a bearer token obtained from SASLogon.
# Tokens expire per your Viya policy — fine for demos, not for production.
#RAM_TOKEN=eyJhbGciOi...

# Option B (recommended): register an OAuth client in SAS Environment Manager
# and let the backend fetch + refresh tokens automatically.
#SAS_CLIENT_ID=ram-chat-ui
#SAS_CLIENT_SECRET=secret
# Optional — use the password grant (acts as this user) instead of client_credentials:
#SAS_USERNAME=
#SAS_PASSWORD=
# Optional — override the token endpoint (default: derived from RAM_API_URL):
#SAS_LOGON_URL=https://your-viya-host/SASLogon/oauth/token

# Set to false if your Viya environment uses self-signed certificates
#RAM_VERIFY_SSL=true

# Demo mode: run the whole UI against an in-memory mock, no Viya needed
#RAM_MOCK=true
